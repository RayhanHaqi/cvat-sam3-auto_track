CVAT_BASE_URL=https://app.cvat.ai  # Your CVAT instance URL
CVAT_ACCESS_TOKEN=your_cvat_token  # Required: get from CVAT UI → Profile → Security
IMAGE_URL=your_repo:your_image_tag  # e.g. myrepo/ostrack384:latest
AGENTS_COUNT=1
ORG_SLUG=""  # Set to your org short name if deploying for an organization
USE_CUDA=false  # Set to true to use GPU (ensure image has CUDA support)
